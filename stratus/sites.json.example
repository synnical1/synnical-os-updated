{
  "sites": {
    "main": {
      "api_key": "CHANGE_ME_PUBLIC_SITE_KEY",
      "enabled": true,
      "max_concurrent_sessions": 5,
      "max_session_seconds": 7200,
      "limits": {
        "per_minute": 60,
        "per_hour": 1000,
        "per_day": 10000,
        "per_month": 100000
      }
    }
  }
}
