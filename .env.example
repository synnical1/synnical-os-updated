# Synnical — no real secrets belong in this file.
# Public variables are embedded by next build; rebuild after changing them.

# REQUIRED on the future Ubuntu VPS. Generate two different random secrets.
DATABASE_URL=file:/var/lib/synnical/database/synnical.db
OWNER_PASSWORD=
IDENTITY_HASH_SECRET=

# Networking / custom Node server. PM2 also pins HOSTNAME to loopback.
NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3000
NEXT_PUBLIC_SOCKET_URL=/socket.io

# Persistent data, outside the source tree. These directories must be writable.
UPLOAD_DIR=/var/lib/synnical/uploads
MEDIA_APPROVALS_DIR=/var/lib/synnical/media-approvals

# SynnFlix / Synnime catalogue: configure either TMDB credential, not both.
TMDB_API_READ_TOKEN=
TMDB_API_KEY=

# AI chat / Synn Bot. At least one key enables completions.
AI_PROVIDER_ORDER=openrouter,groq,gemini
OPENROUTER_API_KEY=
# Blank model uses the provider account default. Set a model your key can use.
OPENROUTER_MODEL=
OPENROUTER_CHAT_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_HTTP_REFERER=https://www.synnical.co.uk
OPENROUTER_APP_TITLE=Synnical
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# OpenAI is used for moderation/transcription, not AI chat completions.
# Hybrid text moderation has a local fallback. Strict requires the provider.
TEXT_MODERATION_MODE=hybrid
MODERATION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_MODERATION_URL=https://api.openai.com/v1/moderations
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIPTION_URL=https://api.openai.com/v1/audio/transcriptions
PROFILE_UPLOAD_MAX_BYTES=16777216
PROFILE_ANIMATION_MAX_FRAMES=600
PROFILE_ANIMATION_MAX_PIXELS=384000000

# Music: public Audius reads can work without a key; other sources are optional.
AUDIUS_API_KEY=
AUDIUS_BEARER_TOKEN=
PIPED_API_BASE=
INVIDIOUS_API_BASE=
COBALT_API_BASE=
COBALT_API_KEY=

# Browser / Wisp. Built-in proxy requires an authenticated Synnical session.
# Use these default paths with the bundled client; custom direct URL below.
WISP_ENABLED=true
WISP_PATH=/wisp
WISP_NL_PATH=/wisp-nl
NEXT_PUBLIC_WISP_URL=
# Optional real Netherlands SOCKS5 egress; credentials are server-only.
SYNNICAL_NL_SOCKS5_URL=

# Cloud Games. Stratus ships as part of Synnical and is enabled by default.
# The public site identifier is browser-visible by design; it is not a provider secret.
# Leave these blank/default unless you intentionally run a custom Stratus site config.
STRATUS_SITES_PATH=
STRATUS_PUBLIC_DIR=
NEXT_PUBLIC_STRATUS_API_KEY=
# Emergency operator kill-switch only.
SYNNICAL_DISABLE_STRATUS=false
GAME_MAIL_API_BASE=https://api.mail.gw
RACCOON_BROWSER_MODEL=Chrome/150.0.0.0
SYNNICAL_PROVIDER_WAIT_MAX_MS=300000

# Synn VM embeds an external VM; blank shows the configuration message.
NEXT_PUBLIC_SYNN_VM_URL=

# Optional GIF search and voice/video calling.
NEXT_PUBLIC_GIPHY_API_KEY=
# JSON array of RTCIceServer objects. Blank uses the existing public STUN default.
# TURN credentials configured here are visible to browser users.
NEXT_PUBLIC_WEBRTC_ICE_SERVERS_JSON=

# Optional operator-controlled ad script. Blank leaves ad injection disabled.
# Ad blocking remains controlled by account settings.
NEXT_PUBLIC_AD_SCRIPT_URL=
NEXT_PUBLIC_AD_ALLOWED_HOSTS=

# Legacy Turso branch only; not used by this SQLite recovery deployment.
# Its optional adapter packages are not in this source's lockfile; see report.
DATABASE_AUTH_TOKEN=

# Development-only destructive maintenance confirmations. Keep blank normally.
SYNNICAL_CONFIRM_DELETE_EXACT_S=
SYNNICAL_CONFIRM_FULL_UNBAN=

# Development validation only: optional log output from disposable smoke checks.
SYNNICAL_SMOKE_LOG=
# Optional explicit Chromium binary for the browser smoke check on ARM64 hosts.
SYNNICAL_CHROMIUM_PATH=

# Historical August installer controls (not used by the ARM64 recovery guide).
# They are included for inventory completeness; do not use the old installers.
SYNNICAL_APP_DIR=
SYNNICAL_PM2_APP_NAME=
SYNNICAL_READY_URL=
SYNNICAL_PREFLIGHT_PORT=
SYNNICAL_BACKUP_ROOT=
SYNNICAL_READINESS_ATTEMPTS=
