# Replace synnical.example.com, install in /etc/nginx/sites-available/synnical,
# enable its sites-enabled symlink, test nginx -t, then obtain TLS with Certbot.
# This file belongs inside nginx's http context (Ubuntu sites-enabled).
map $http_upgrade $synnical_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    listen [::]:80;
    server_name synnical.example.com;
    client_max_body_size 84m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite untrusted incoming headers at the public edge.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $synnical_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        # Next serves uploads, private screenshots, workers and runtime assets.
        # Do not expose UPLOAD_DIR directly or add blanket asset cache headers.
    }
}
